{% extends 'base.html.twig' %}

{% block title %}Mes tâches{% endblock %}

{% block body %}
<main class="page-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">Gestion des tâches</p>
            <h1>Mes tâches</h1>
            <p class="muted">Ajoutez, priorisez et suivez le travail de votre équipe.</p>
        </div>
        <a class="button button-primary" href="{{ path('task_new') }}">Nouvelle tâche</a>
    </header>
    {% for message in app.flashes('success') %}<div class="flash">{{ message }}</div>{% endfor %}
    <form class="filters" method="get">
        <label>Statut<select name="status"><option value="">Tous les statuts</option>{% for status in statuses %}<option value="{{ status }}" {{ current_status == status ? 'selected' }}>{{ status }}</option>{% endfor %}</select></label>
        <label>Priorité<select name="priority"><option value="">Toutes les priorités</option>{% for priority in priorities %}<option value="{{ priority }}" {{ current_priority == priority ? 'selected' }}>{{ priority }}</option>{% endfor %}</select></label>
        <button class="button button-secondary" type="submit">Filtrer</button>
        <a class="clear-filter" href="{{ path('task_index') }}">Réinitialiser</a>
    </form>
    <section class="task-list">
        {% for task in tasks %}
            <article class="task-row">
                <div class="task-main"><div class="task-title-line"><a href="{{ path('task_show', {id: task.id}) }}">{{ task.title }}</a><span class="badge">{{ task.priority }}</span></div><p>{{ task.description ?: 'Aucune description' }}</p></div>
                <span class="status">{{ task.status }}</span>
                <span class="assignee">{{ task.assignee ? task.assignee.name : 'Non assignée' }}</span>
                <div class="row-actions"><form method="post" action="{{ path('task_toggle_status', {id: task.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('toggle-status' ~ task.id) }}"><button class="link-status" type="submit">{{ task.status == 'Terminée' ? 'Rouvrir' : 'Marquer comme faite' }}</button></form><a href="{{ path('task_edit', {id: task.id}) }}">Modifier</a><form method="post" action="{{ path('task_delete', {id: task.id}) }}" onsubmit="return confirm('Supprimer cette tâche ?');"><input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}"><button class="link-danger" type="submit">Supprimer</button></form></div>
            </article>
        {% else %}
            <div class="empty-state"><strong>Aucune tâche trouvée</strong><span>Créez votre première tâche pour commencer.</span><a class="button button-primary" href="{{ path('task_new') }}">Créer une tâche</a></div>
        {% endfor %}
    </section>
</main>
{% endblock %}