{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}
<main class="page-shell narrow"><a class="back-link" href="{{ path('user_index') }}">Retour aux utilisateurs</a><header class="page-header compact"><div><p class="eyebrow">Équipe</p><h1>{{ page_title }}</h1></div></header><div class="form-panel">{{ form_start(form) }}{{ form_row(form.name) }}{{ form_row(form.email) }}<div class="form-actions"><a class="button button-secondary" href="{{ path('user_index') }}">Annuler</a><button class="button button-primary" type="submit">Enregistrer</button></div>{{ form_end(form) }}</div></main>
{% endblock %}